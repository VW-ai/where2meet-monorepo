# Copy this file to .env.local and fill in your values

# ============================================================================
# Mock Configuration (NEW - Granular Control)
# ============================================================================

# Client-visible (exposed to browser)
# Mode: full | partial | off
NEXT_PUBLIC_MOCK_MODE=off
# Comma-separated list of domains to mock (auth,users,events,venues)
NEXT_PUBLIC_MOCK_DOMAINS=auth,users

# Browser API and event-stream requests
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# Server-only (NOT exposed to browser - more secure)
BACKEND_URL=http://localhost:3000
# Server-side override if needed (full | partial | off)
# MOCK_MODE=partial
# Server-side domain list override
# MOCK_DOMAINS=auth,users

# ============================================================================
# Legacy Mock Configuration (DEPRECATED - use above instead)
# ============================================================================
# NEXT_PUBLIC_USE_MOCK_API=true
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ============================================================================
# Google Maps
# ============================================================================
# Google Maps API Key (required)
# Get yours at: https://console.cloud.google.com/google/maps-apis
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_browser_key

# ============================================================================
# App Configuration
# ============================================================================
# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ============================================================================
# Analytics
# ============================================================================
# Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX)
# Get yours at:     
# Leave empty to disable analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ============================================================================
# Blog posts from the Control Panel (/blog), contract v3: docs/blog-posts-contract.md
# ============================================================================
# Server-only. The control plane that serves published posts, and its read token.
# Without both, the site builds and serves the repo's posts alone.
CONTROL_PLANE_URL=
CONTROL_PLANE_READ_TOKEN=
# Local dev and tests only: read posts from a JSON file instead of the control plane.
# Ignored when VERCEL_ENV=production. Sample: src/features/blog/__fixtures__/published.json
# CONTROL_PLANE_FIXTURE=/absolute/path/to/published.json
