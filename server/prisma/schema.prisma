// Where2Meet Database Schema
// See META/ARCHITECTURE/DATABASE_SCHEMA.md for design documentation

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Event - Core entity for organizing a meeting
// Event ID format: evt_<timestamp>_<random16> (semantic ID, not UUID)
// Note: Organizer is identified via Participant.isOrganizer, not a separate token
model Event {
  id               String    @id @db.VarChar(64)
  title            String    @db.VarChar(100)
  meetingTime      DateTime? @map("meeting_time")
  publishedVenueId String?   @map("published_venue_id") @db.VarChar(255)
  publishedAt      DateTime? @map("published_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  participants Participant[]
  votes        Vote[]
  userEvents   UserEvent[]

  @@index([createdAt])
  @@map("event")
}

// Participant - People joining an event with their location
// Note: Organizer participants (isOrganizer=true) have nullable location fields
model Participant {
  id               String   @id @default(uuid()) @db.Uuid
  eventId          String   @map("event_id") @db.VarChar(64)
  name             String   @db.VarChar(50)
  address          String?  @db.VarChar(255) // Nullable for organizer participant
  formattedAddress String?  @map("formatted_address") @db.VarChar(255)
  lat              Decimal? @db.Decimal(10, 7) // Nullable for organizer participant
  lng              Decimal? @db.Decimal(10, 7) // Nullable for organizer participant
  fuzzyLocation    Boolean  @default(false) @map("fuzzy_location")
  color            String   @db.VarChar(20)
  isOrganizer      Boolean  @default(false) @map("is_organizer") // True for auto-created organizer participant
  tokenHash        String?  @map("token_hash") @db.VarChar(64)
  createdAt        DateTime @default(now()) @map("created_at")

  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  votes     Vote[]
  userEvent UserEvent?

  @@index([eventId])
  @@map("participant")
}

// Venue - Global venue cache from Google Places (with refresh logic)
// Design: Single source of truth for venue data, shared across all events
// The Vote table tracks which venues are voted on in which events
model Venue {
  id         String   @id @db.VarChar(255) // Google Place ID
  name       String   @db.VarChar(255)
  address    String?  @db.VarChar(255)
  lat        Decimal  @db.Decimal(10, 7)
  lng        Decimal  @db.Decimal(10, 7)
  category   String?  @db.VarChar(50)
  rating     Decimal? @db.Decimal(2, 1)
  priceLevel Int?     @map("price_level") @db.SmallInt
  photoUrl   String?  @map("photo_url") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at") // For 5-day refresh logic

  votes Vote[]

  @@map("venue")
}

// Vote - Junction table tracking which participants voted for which venues in which events
// This is the vote tracking table that handles the many-to-many-to-many relationship
model Vote {
  id            String   @id @default(uuid()) @db.Uuid
  eventId       String   @map("event_id") @db.VarChar(64)
  participantId String   @map("participant_id") @db.Uuid
  venueId       String   @map("venue_id") @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at")

  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  venue       Venue       @relation(fields: [venueId], references: [id])

  @@unique([eventId, participantId, venueId])
  @@index([eventId])
  @@index([participantId])
  @@index([venueId])
  @@index([eventId, venueId]) // Composite index for vote aggregation queries
  @@map("vote")
}

// ============================================================================
// User Management Models (Milestone 8)
// ============================================================================

// User - Core user account for dashboard and preferences
// User ID format: usr_<32 hex chars>
model User {
  id                   String    @id @db.VarChar(64)
  email                String    @unique @db.VarChar(255)
  name                 String?   @db.VarChar(255)
  avatarUrl            String?   @map("avatar_url") @db.VarChar(512)
  emailVerified        Boolean   @default(false) @map("email_verified")
  defaultAddress       String?   @map("default_address") @db.Text
  defaultPlaceId       String?   @map("default_place_id") @db.VarChar(255)
  defaultFuzzyLocation Boolean   @default(false) @map("default_fuzzy_location")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  identities UserIdentity[]
  sessions   UserSession[]
  userEvents UserEvent[]

  @@index([email])
  @@map("user")
}

// UserIdentity - Multi-provider authentication support
// Identity ID format: ident_<32 hex chars>
// Supports email/password now, OAuth providers in future
model UserIdentity {
  id           String   @id @db.VarChar(64)
  userId       String   @map("user_id") @db.VarChar(64)
  provider     String   @db.VarChar(50) // 'email' | 'google' | 'github'
  providerId   String   @map("provider_id") @db.VarChar(255) // email or OAuth ID
  passwordHash String?  @map("password_hash") @db.VarChar(255) // bcrypt hash, email only
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@map("user_identity")
}

// UserSession - Server-side session storage with HttpOnly cookies
// Session ID format: ses_<32 hex chars>
// Session token format: st_<64 hex chars> (stored as SHA-256 hash)
model UserSession {
  id        String   @id @db.VarChar(64)
  userId    String   @map("user_id") @db.VarChar(64)
  tokenHash String   @unique @map("token_hash") @db.VarChar(64) // SHA-256 hash
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_session")
}

// UserEvent - Links users to events they've created or participated in
// UserEvent ID format: ue_<32 hex chars>
// Enables dashboard view of all user's events
model UserEvent {
  id            String   @id @db.VarChar(64)
  userId        String   @map("user_id") @db.VarChar(64)
  eventId       String   @map("event_id") @db.VarChar(64)
  participantId String?  @unique @map("participant_id") @db.Uuid
  role          String   @db.VarChar(20) // 'organizer' | 'participant'
  createdAt     DateTime @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participant Participant? @relation(fields: [participantId], references: [id], onDelete: SetNull)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
  @@map("user_event")
}
