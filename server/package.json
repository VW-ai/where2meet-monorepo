{
  "name": "where2meet-server",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "DATABASE_URL=\"${DATABASE_URL:-postgresql://unused:unused@localhost:5432/unused}\" prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests scripts",
    "lint:fix": "eslint src tests scripts --fix",
    "format": "prettier --write \"{src,tests,scripts}/**/*.ts\"",
    "format:check": "prettier --check \"{src,tests,scripts}/**/*.ts\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "type-check": "tsc --noEmit",
    "db:migrate:deploy": "prisma migrate deploy",
    "check:boundaries": "node --import tsx scripts/check-architecture.ts",
    "import:data": "node --import tsx scripts/import-cli.ts",
    "verify": "npm run type-check && npm run lint && npm run format:check && npm run check:boundaries && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/V1ctor2182/where2meet-monorepo.git",
    "directory": "server"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/V1ctor2182/where2meet-monorepo/issues"
  },
  "homepage": "https://github.com/V1ctor2182/where2meet-monorepo/tree/main/server#readme",
  "description": "Where2Meet backend server - find the perfect meeting spot",
  "dependencies": {
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "^6.19.1",
    "bcryptjs": "3.0.3",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.8.2",
    "pino": "^10.1.0",
    "prisma": "^6.19.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^25.0.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^61.5.0",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.7.4",
    "supertest": "^7.1.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
