# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# Prefer CORS_ORIGINS (comma-separated allowlist). In production, do NOT use "*".
# Examples:
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# CORS_ORIGINS=https://app.where2meet.com,https://staging.where2meet.com
CORS_ORIGINS=http://localhost:3001
# Backwards-compatible name (avoid using this for new setups):
# CORS_ORIGIN=*

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/where2meet?schema=public"

# Redis
REDIS_URL="redis://localhost:6380"

# Google Maps API (for future milestones)
# GOOGLE_MAPS_API_KEY=your_api_key_here

# AMap (Gaode) Web Service key for China events (https://console.amap.com/dev/key/app).
# Create a key of type "Web服务". Leave empty to disable China map data.
# AMAP_WEB_SERVICE_KEY=your_amap_web_service_key

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
