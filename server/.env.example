# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=* # Use "*" for all origins or comma-separated list: "https://app.vercel.app,https://staging.vercel.app"

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/where2meet?schema=public"

# Redis
REDIS_URL="redis://localhost:6380"

# Google Maps API (for future milestones)
# GOOGLE_MAPS_API_KEY=your_api_key_here

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
