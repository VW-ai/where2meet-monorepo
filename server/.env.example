# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# Prefer CORS_ORIGINS (comma-separated allowlist). In production, do NOT use "*".
# Examples:
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# CORS_ORIGINS=https://app.where2meet.com,https://staging.where2meet.com
CORS_ORIGINS=http://localhost:3001
# Backwards-compatible name (avoid using this for new setups):
# CORS_ORIGIN=*

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/where2meet?schema=public"

# Redis
REDIS_URL="redis://localhost:6380"

# Google Maps Geocoding API (participant locations)
# GOOGLE_MAPS_API_KEY=your_api_key_here
GEOCODE_TIMEOUT_MS=5000

PLACES_TIMEOUT_MS=5000
SEARCH_TIMEOUT_MS=10000
ROUTE_TIMEOUT_MS=10000
PHOTO_TIMEOUT_MS=10000
PLACES_SEARCH_TTL_SECONDS=3600
PLACES_DETAILS_TTL_SECONDS=86400
ROUTE_TTL_SECONDS=3600

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
